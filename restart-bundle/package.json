{
  "name": "@local/dsh-restart",
  "version": "1.0.0",
  "private": true,
  "description": "Top-left Restart control that restarts the whole DSH Desktop application and Host, after flushing persistent browser storage.",
  "license": "MIT",
  "author": "shiyangjian6-code",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "restart",
    "desktop"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiyangjian6-code/dsh-new-chat.git",
    "directory": "restart-bundle"
  },
  "homepage": "https://github.com/shiyangjian6-code/dsh-new-chat#readme",
  "bugs": {
    "url": "https://github.com/shiyangjian6-code/dsh-new-chat/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
