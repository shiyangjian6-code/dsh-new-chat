{
  "name": "@local/dsh-new-chat",
  "version": "1.1.0",
  "private": true,
  "description": "Open the official DeepSeek web chat in a wide DSH sidebar panel, with cross-restart login persistence through a companion desktop patch.",
  "license": "MIT",
  "author": "shiyangjian6-code",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "deepseek",
    "webview",
    "sidebar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shiyangjian6-code/dsh-new-chat.git",
    "directory": "bundle"
  },
  "homepage": "https://github.com/shiyangjian6-code/dsh-new-chat#readme",
  "bugs": {
    "url": "https://github.com/shiyangjian6-code/dsh-new-chat/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
